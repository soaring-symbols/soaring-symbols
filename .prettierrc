{
    "singleQuote": true,
    "semi": false,
    "tabWidth": 4,
    "trailingComma": "all",
    "printWidth": 80,
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.md"],
            "options": {
                "tabWidth": 2,
                "embeddedLanguageFormatting": "off"
            }
        }
    ]
}
