{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/soaring-symbols/soaring-symbols/airlines.schema.json",
    "title": "Soaring Symbols airlines",
    "description": "The airline catalog in airlines.json. `slug` and `assets` are written by `npm run generate`; never edit them by hand.",
    "type": "array",
    "items": { "$ref": "#/$defs/airline" },
    "$defs": {
        "iata": {
            "description": "Two-character IATA airline code, e.g. \"VN\".",
            "type": "string",
            "pattern": "^[A-Z0-9]{2}$"
        },
        "icao": {
            "description": "Three-letter ICAO airline code, e.g. \"HVN\".",
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "country": {
            "description": "ISO 3166-1 alpha-2 code (or an ISO 3166-2 subdivision such as \"GB-SCT\"); several are comma-separated without spaces, e.g. \"DK,NO,SE\".",
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z]{2,3})?(,[A-Z]{2}(-[A-Z]{2,3})?)*$"
        },
        "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
        },
        "hexColor": {
            "description": "Six-digit lowercase hex color, e.g. \"#d99e09\".",
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(.*\\S)?$"
        },
        "airline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "iata",
                "icao",
                "country",
                "website",
                "branding",
                "slug",
                "assets"
            ],
            "properties": {
                "name": {
                    "$ref": "#/$defs/name",
                    "description": "Full name of the airline; the array is sorted by it."
                },
                "iata": { "$ref": "#/$defs/iata" },
                "icao": { "$ref": "#/$defs/icao" },
                "callsign": {
                    "description": "ICAO radiotelephony callsign, uppercase, e.g. \"VIET NAM AIRLINES\".",
                    "type": "string",
                    "pattern": "^[A-Z0-9]+([ '.-][A-Z0-9]+)*$"
                },
                "country": { "$ref": "#/$defs/country" },
                "flag_carrier": { "type": "boolean" },
                "website": {
                    "$ref": "#/$defs/url",
                    "description": "Official website of the airline."
                },
                "alliance": {
                    "enum": [
                        "oneworld",
                        "SkyTeam",
                        "Star Alliance",
                        "Value Alliance",
                        "Vanilla Alliance"
                    ]
                },
                "defunct": {
                    "description": "The airline has ceased operations.",
                    "type": "boolean"
                },
                "vectorized": {
                    "description": "The SVGs were vectorized by hand.",
                    "type": "boolean"
                },
                "branding": { "$ref": "#/$defs/branding" },
                "subsidiaries": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/subsidiary" }
                },
                "slug": {
                    "description": "Generated from `name` by `npm run generate`.",
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "assets": { "$ref": "#/$defs/assets" }
            }
        },
        "branding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primary_color"],
            "properties": {
                "primary_color": { "$ref": "#/$defs/hexColor" },
                "tagline": { "type": "string", "minLength": 1 },
                "guidelines": {
                    "$ref": "#/$defs/url",
                    "description": "Link to the airline's brand guidelines."
                }
            }
        },
        "subsidiary": {
            "description": "An airline listed under a parent airline; it has no assets of its own.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "iata", "icao", "country"],
            "properties": {
                "name": { "$ref": "#/$defs/name" },
                "iata": { "$ref": "#/$defs/iata" },
                "icao": { "$ref": "#/$defs/icao" },
                "country": { "$ref": "#/$defs/country" },
                "flag_carrier": { "type": "boolean" }
            }
        },
        "assets": {
            "description": "Generated by `npm run generate` from the files in assets/<slug>/.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "icon": { "$ref": "#/$defs/assetInfo" },
                "logo": { "$ref": "#/$defs/assetInfo" },
                "tail": { "$ref": "#/$defs/assetInfo" }
            }
        },
        "assetInfo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["color", "mono", "colors"],
            "properties": {
                "color": { "type": "boolean" },
                "mono": { "type": "boolean" },
                "colors": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/hexColor" }
                }
            }
        }
    }
}
