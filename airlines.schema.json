{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/soaring-symbols/soaring-symbols/airlines.schema.json",
    "title": "Soaring Symbols airlines",
    "description": "The airline catalog in airlines.json, as kept in the repo. The build adds `assets` to every entry of the copy it publishes, `history` to those with older marks and `predecessors` to those that carried on a defunct airline (see $defs/published); leave them out of the repo.",
    "type": "array",
    "items": { "$ref": "#/$defs/airline" },
    "$defs": {
        "published": {
            "description": "The catalog the package ships in dist/airlines.json: every entry also has `assets`, `history` when it has older marks and `predecessors` when it carried on a defunct airline.",
            "type": "array",
            "items": {
                "allOf": [
                    { "$ref": "#/$defs/airline" },
                    { "type": "object", "required": ["assets"] }
                ]
            }
        },
        "iata": {
            "description": "Two-character IATA airline code, e.g. \"VN\".",
            "type": "string",
            "pattern": "^[A-Z0-9]{2}$"
        },
        "icao": {
            "description": "Three-letter ICAO airline code, e.g. \"HVN\".",
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "country": {
            "description": "ISO 3166-1 alpha-2 code (or an ISO 3166-2 subdivision such as \"GB-SCT\"); several are comma-separated without spaces, e.g. \"DK,NO,SE\".",
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z]{2,3})?(,[A-Z]{2}(-[A-Z]{2,3})?)*$"
        },
        "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
        },
        "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
        },
        "hexColor": {
            "description": "Six-digit lowercase hex color, e.g. \"#d99e09\".",
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
        },
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(.*\\S)?$"
        },
        "airline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "slug",
                "iata",
                "icao",
                "country",
                "website",
                "branding"
            ],
            "dependentSchemas": {
                "ceased": {
                    "required": ["defunct"],
                    "properties": { "defunct": { "const": true } }
                },
                "successor": {
                    "required": ["defunct"],
                    "properties": { "defunct": { "const": true } }
                }
            },
            "properties": {
                "name": {
                    "$ref": "#/$defs/name",
                    "description": "Full name of the airline; the array is sorted by it."
                },
                "slug": {
                    "description": "Identifier of the airline and the name of its assets/<slug>/ folder. Must be the slugified name; `npm run generate` fills it in when missing.",
                    "$ref": "#/$defs/slug"
                },
                "iata": { "$ref": "#/$defs/iata" },
                "icao": { "$ref": "#/$defs/icao" },
                "callsign": {
                    "description": "ICAO radiotelephony callsign in uppercase, accented letters included, e.g. \"VIET NAM AIRLINES\" or \"LAN PERÚ\".",
                    "type": "string",
                    "pattern": "^[\\p{Lu}0-9]+([ '.-][\\p{Lu}0-9]+)*$"
                },
                "country": { "$ref": "#/$defs/country" },
                "flag_carrier": { "type": "boolean" },
                "website": {
                    "$ref": "#/$defs/url",
                    "description": "Official website of the airline."
                },
                "alliance": {
                    "enum": [
                        "oneworld",
                        "SkyTeam",
                        "Star Alliance",
                        "Value Alliance",
                        "Vanilla Alliance"
                    ]
                },
                "parent": {
                    "description": "Slug of the airline in this catalog that owns this one, e.g. \"airasia\" for Thai AirAsia.",
                    "$ref": "#/$defs/slug"
                },
                "marks": {
                    "description": "Slug of the airline whose SVGs this one uses, when it has none of its own: often the parent, or a sibling that shares a different logo. The build copies those files to this airline's slug.",
                    "$ref": "#/$defs/slug"
                },
                "hubs": {
                    "description": "IATA codes of the airline's hub airports, e.g. [\"HAN\", \"SGN\"]. Operating bases of low-cost carriers are not hubs.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
                },
                "founded": {
                    "description": "Year the airline (or the predecessor it counts its history from) was founded.",
                    "$ref": "#/$defs/year"
                },
                "defunct": {
                    "description": "The airline has ceased operations.",
                    "type": "boolean"
                },
                "ceased": {
                    "description": "Year a defunct airline ceased operations.",
                    "$ref": "#/$defs/year"
                },
                "successor": {
                    "description": "Slug of the airline that carried on this defunct one, after a rename or a merger, e.g. \"air-india\" for Vistara. The defunct entry keeps its own slug and SVGs.",
                    "$ref": "#/$defs/slug"
                },
                "predecessors": {
                    "description": "Added by the build: slugs of the defunct airlines whose `successor` is this one, oldest first; only in the published catalog.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/slug" }
                },
                "vectorized": {
                    "description": "Deprecated: removed in 0.3. The SVGs were vectorized by hand; a pull request's description records each SVG's source instead.",
                    "deprecated": true,
                    "type": "boolean"
                },
                "branding": { "$ref": "#/$defs/branding" },
                "assets": {
                    "description": "Added by the build from the SVGs; only in the published catalog.",
                    "$ref": "#/$defs/assets"
                },
                "history": {
                    "description": "Added by the build from assets/<slug>/history/<year>/ when the airline has older marks; only in the published catalog.",
                    "$ref": "#/$defs/history"
                }
            }
        },
        "branding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primary_color"],
            "properties": {
                "primary_color": { "$ref": "#/$defs/hexColor" },
                "tagline": { "type": "string", "minLength": 1 },
                "guidelines": {
                    "$ref": "#/$defs/url",
                    "description": "Link to the airline's brand guidelines."
                }
            }
        },
        "assets": {
            "description": "Added by the build from the files in assets/<slug>/.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "icon": { "$ref": "#/$defs/assetInfo" },
                "logo": { "$ref": "#/$defs/assetInfo" },
                "tail": { "$ref": "#/$defs/assetInfo" }
            }
        },
        "history": {
            "description": "The marks an airline used before its current ones, oldest first. Each was used from `since` until the next entry's `since`, the last one until the current marks; its files are at assets/<slug>/history/<since>/.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["since", "assets"],
                "properties": {
                    "since": {
                        "description": "Year the mark was introduced, also its folder name.",
                        "$ref": "#/$defs/year"
                    },
                    "assets": { "$ref": "#/$defs/assets" }
                }
            }
        },
        "assetInfo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["color", "mono", "colors"],
            "properties": {
                "color": { "type": "boolean" },
                "mono": { "type": "boolean" },
                "colors": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/hexColor" }
                }
            }
        }
    }
}
