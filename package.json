{
  "name": "soaring-symbols",
  "version": "0.1.0-alpha.14",
  "description": "A curated collection of airline branding assets — logos, icons, and tail designs in SVG format.",
  "license": "MIT",
  "author": {
    "name": "Anh Thang Bui",
    "email": "buianhthang89@gmail.com",
    "url": "https://anhthang.org"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svg-validator": {
      "types": "./dist/svg-validator.d.ts",
      "import": "./dist/svg-validator.js",
      "require": "./dist/svg-validator.cjs"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./package.json": "./package.json",
    "./assets/*": "./dist/assets/*"
  },
  "homepage": "https://github.com/soaring-symbols/soaring-symbols",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/soaring-symbols/soaring-symbols.git"
  },
  "bugs": {
    "url": "https://github.com/soaring-symbols/soaring-symbols/issues"
  },
  "keywords": [
    "aviation",
    "airline",
    "logo",
    "icon",
    "soaring",
    "symbols",
    "svg",
    "aircraft",
    "aviation",
    "flight",
    "travel"
  ],
  "files": [
    "dist/",
    "AIRLINES.md",
    "API.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf dist",
    "prebuild": "npm run lint:svg && npm run generate",
    "build": "npm run clean && node scripts/build.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node scripts/test.js",
    "test:swift": "swift test",
    "lint:svg": "node scripts/lint-svg.js",
    "generate": "node scripts/generate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts}\"",
    "release": "node scripts/release.js",
    "optimize": "svgo --config svgo.config.mjs"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^27.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^17.0.4",
    "lodash.sortby": "^4.7.0",
    "prettier": "^3.8.3",
    "svgo": "4.0.0"
  }
}
