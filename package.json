{
  "name": "soaring-symbols",
  "version": "0.2.2",
  "description": "A curated collection of airline branding assets — logos, icons, and tail designs in SVG format.",
  "license": "MIT",
  "author": {
    "name": "Anh Thang Bui",
    "email": "buianhthang89@gmail.com",
    "url": "https://anhthang.org"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./svg-validator": {
      "import": {
        "types": "./dist/svg-validator.d.ts",
        "default": "./dist/svg-validator.js"
      },
      "require": {
        "types": "./dist/svg-validator.d.cts",
        "default": "./dist/svg-validator.cjs"
      }
    },
    "./package.json": "./package.json",
    "./assets/*": "./dist/assets/*"
  },
  "homepage": "https://github.com/soaring-symbols/soaring-symbols",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/soaring-symbols/soaring-symbols.git"
  },
  "bugs": {
    "url": "https://github.com/soaring-symbols/soaring-symbols/issues"
  },
  "keywords": [
    "aviation",
    "airline",
    "logo",
    "icon",
    "soaring",
    "symbols",
    "svg",
    "aircraft",
    "aviation",
    "flight",
    "travel"
  ],
  "files": [
    "dist/",
    "API.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf dist",
    "prebuild": "npm run lint:svg && npm run generate",
    "build": "npm run clean && node scripts/build.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node scripts/test.js",
    "lint:svg": "node scripts/lint-svg.js",
    "generate": "node scripts/generate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts}\"",
    "format:check": "prettier --check \"**/*.{js,ts}\"",
    "release": "node scripts/release.js",
    "sync:data": "node scripts/sync-data.js",
    "optimize": "svgo --config svgo.config.mjs"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^27.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^17.6.0",
    "lodash.sortby": "^4.7.0",
    "prettier": "^3.9.10",
    "slugify": "^1.6.6",
    "svgo": "4.1.0"
  }
}
